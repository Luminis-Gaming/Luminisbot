# Discord Bot Configuration
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Warcraft Logs API Configuration
WCL_CLIENT_ID=your_wcl_client_id_here
WCL_CLIENT_SECRET=your_wcl_client_secret_here
# Optional: the v1 API key ("V1 Client Key" on warcraftlogs.com/profile). v1 has its own rate limit,
# so raid analysis carries on there when v2 is rate limited or its share of the hour is used.
WCL_V1_API_KEY=
# Optional: v1 lists the guild's reports by name - learned from v2 by itself, or set here
WCL_GUILD_NAME=
WCL_GUILD_SERVER=
WCL_GUILD_REGION=

# WCL browser session for wipe parses (optional)
# The API only returns parse % for kills; wipe parses exist only on the website, which
# sits behind a human check. To show them, the bot reuses a session from your browser:
#   1. Log in to warcraftlogs.com with "remember me" ticked and open any report page.
#   2. DevTools (F12) -> Network -> click any request to warcraftlogs.com -> Request Headers.
#   3. Copy the entire value of the "Cookie:" header (it includes human_verified,
#      wcl_session, XSRF-TOKEN and remember_web_*). Paste it below as one line.
#   4. Copy the "User-Agent:" header value too, so the session matches your browser.
# When the session expires the bot logs "[WARN] WCL rejected the configured browser session".
WCL_SCRAPE_COOKIES=
WCL_SCRAPE_USER_AGENT=

# Public address of the web server (no trailing slash, no /raids). Discord links to the
# read-only raid analysis pages use it. Defaults to https://luminisbot.flipflix.no in docker-compose.
RAID_ANALYSIS_PUBLIC_URL=https://luminisbot.flipflix.no

# Database Configuration (PostgreSQL)
# Set a secure password for your PostgreSQL database
POSTGRES_PASSWORD=your_secure_database_password_here

# Warcraft Recorder Configuration (for /warcraftrecorder command)
RECORDER_EMAIL=your_warcraft_recorder_email_here
RECORDER_PASSWORD=your_warcraft_recorder_password_here

# SimCraft Integration (for /sim command)
SIMCRAFT_API_URL=your_simcraft_api_url_here
SIMCRAFT_API_KEY=your_simcraft_api_key_here
# Optional: override the URL used in result links (if different from API URL)
# SIMCRAFT_RESULT_URL=https://sim.flipflix.no
